---
import { Icon } from 'astro-icon/components'
interface Props {
  link: string;
}

const { link } = Astro.props;
---

<a href={link} class="navbar-brand inline-block" title="Inicio">
  <Icon name="logo-sotomayor-consulting-ecuador" class="text-4xl invert" title="Logo Sotomayor consulting Ecuador"/>
</a>
